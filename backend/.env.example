# Copy to backend/.env and adjust for production.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=www.chipingerdc.gov.zw,chipingerdc.gov.zw,staff.chipingerdc.gov.zw
DJANGO_CSRF_TRUSTED_ORIGINS=https://www.chipingerdc.gov.zw,https://staff.chipingerdc.gov.zw
DATABASE_URL=postgres://crdc:password@localhost:5432/crdc
# Vouchers / requisitions at or above this USD amount need the CEO's authorisation
CEO_APPROVAL_THRESHOLD=5000
# Online payments: simulated (testing) or paynow (live)
PAYMENT_GATEWAY=simulated
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
PAYNOW_RESULT_URL=https://ems.chipingerdc.gov.zw/api/v1/payments/paynow/result/
PAYNOW_RETURN_URL=https://ems.chipingerdc.gov.zw/portal/receipts/
JWT_ACCESS_HOURS=8
JWT_REFRESH_DAYS=30
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# Two websites: public client site and staff site
CLIENT_HOSTS=www.chipingerdc.gov.zw,chipingerdc.gov.zw
STAFF_HOSTS=staff.chipingerdc.gov.zw
PUBLIC_SITE_URL=https://www.chipingerdc.gov.zw
STAFF_SITE_URL=https://staff.chipingerdc.gov.zw
# SMS reminders: console (log only) or http (bulk SMS provider)
SMS_BACKEND=console
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
SMS_SENDER_ID=ChipingeRDC
