-- Local, role-scoped replica of server records. Each record is stored as the
-- JSON the server sent, so the schema stays stable as the server evolves.
CREATE TABLE record (
    entity TEXT NOT NULL,
    id TEXT NOT NULL,
    json TEXT NOT NULL,
    updated_at TEXT NOT NULL DEFAULT '',
    search_text TEXT NOT NULL DEFAULT '',
    is_deleted INTEGER NOT NULL DEFAULT 0,
    local_pending INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (entity, id)
);
CREATE INDEX record_entity_updated ON record(entity, updated_at);

-- Work captured offline, waiting to be pushed to the server.
CREATE TABLE outbox (
    op_id TEXT NOT NULL PRIMARY KEY,
    type TEXT NOT NULL,
    payload TEXT NOT NULL,
    created_at TEXT NOT NULL,
    status TEXT NOT NULL DEFAULT 'PENDING',
    error TEXT NOT NULL DEFAULT '',
    attempts INTEGER NOT NULL DEFAULT 0,
    entity TEXT NOT NULL DEFAULT '',
    local_id TEXT NOT NULL DEFAULT '',
    summary TEXT NOT NULL DEFAULT ''
);

CREATE TABLE sync_cursor (
    entity TEXT NOT NULL PRIMARY KEY,
    cursor TEXT NOT NULL
);

CREATE TABLE kv (
    key TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL
);

upsertRecord:
INSERT OR REPLACE INTO record(entity, id, json, updated_at, search_text, is_deleted, local_pending)
VALUES (?, ?, ?, ?, ?, ?, ?);

recordsByEntity:
SELECT * FROM record WHERE entity = ? AND is_deleted = 0 ORDER BY local_pending DESC, updated_at DESC;

searchRecords:
SELECT * FROM record WHERE entity = ? AND is_deleted = 0 AND search_text LIKE ('%' || ? || '%')
ORDER BY local_pending DESC, updated_at DESC LIMIT 200;

recordById:
SELECT * FROM record WHERE entity = ? AND id = ?;

deleteRecord:
DELETE FROM record WHERE entity = ? AND id = ?;

clearRecords:
DELETE FROM record;

insertOp:
INSERT INTO outbox(op_id, type, payload, created_at, entity, local_id, summary) VALUES (?, ?, ?, ?, ?, ?, ?);

pendingOps:
SELECT * FROM outbox WHERE status = 'PENDING' ORDER BY created_at LIMIT ?;

allOps:
SELECT * FROM outbox ORDER BY created_at DESC;

markOpRejected:
UPDATE outbox SET status = 'REJECTED', error = ?, attempts = attempts + 1 WHERE op_id = ?;

bumpAttempt:
UPDATE outbox SET attempts = attempts + 1 WHERE op_id = ?;

deleteOp:
DELETE FROM outbox WHERE op_id = ?;

pendingCount:
SELECT count(*) FROM outbox WHERE status = 'PENDING';

rejectedCount:
SELECT count(*) FROM outbox WHERE status = 'REJECTED';

clearOutbox:
DELETE FROM outbox;

getCursor:
SELECT cursor FROM sync_cursor WHERE entity = ?;

allCursors:
SELECT * FROM sync_cursor;

setCursor:
INSERT OR REPLACE INTO sync_cursor(entity, cursor) VALUES (?, ?);

deleteCursor:
DELETE FROM sync_cursor WHERE entity = ?;

clearCursors:
DELETE FROM sync_cursor;

getValue:
SELECT value FROM kv WHERE key = ?;

setValue:
INSERT OR REPLACE INTO kv(key, value) VALUES (?, ?);

deleteValue:
DELETE FROM kv WHERE key = ?;
